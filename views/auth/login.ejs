<%- include('../partials/head') %>
<main class="auth-shell">
  <section class="auth-card">
    <h2>Welcome Back</h2>
    <p class="muted">Login as Admin, Teacher or Student.</p>

    <%- include('../partials/flash') %>

    <form class="form-grid" action="/auth/login" method="post">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />

      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="Enter your password" required autocomplete="current-password" />

      <button type="submit" class="btn btn-primary">Login</button>
    </form>

    <div class="auth-links">
      <a href="/auth/forgot-password">Forgot Password?</a>
      <a href="/auth/register">Create Account</a>
    </div>
  </section>
</main>
<%- include('../partials/scripts') %>
