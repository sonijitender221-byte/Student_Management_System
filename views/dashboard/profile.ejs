<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="content">
    <section class="page-head">
      <h2>Profile</h2>
      <p>Manage account details and profile preferences.</p>
    </section>
    <section class="card profile-grid">
      <div>
        <h3>Account Information</h3>
        <p><strong>Name:</strong> Alex Ray</p>
        <p><strong>Email:</strong> alex@example.com</p>
        <p><strong>Role:</strong> Admin</p>
      </div>
      <form class="form-grid" action="#" method="post">
        <label>Display Name</label>
        <input type="text" value="Alex Ray" />
        <label>Bio</label>
        <textarea rows="4" placeholder="Tell us about yourself"></textarea>
        <button type="submit" class="btn btn-primary">Save Profile</button>
      </form>
    </section>
  </main>
</div>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
